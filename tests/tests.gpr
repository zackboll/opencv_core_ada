with "config/tests_config.gpr";
with "aunit";
with "opencv_core";
with "../config/opencv_core_install.gpr";

project Tests is

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Tests_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("tests.adb");

   package Compiler is
      for Default_Switches ("Ada") use
         Tests_Config.Ada_Compiler_Switches & ("-Werror");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Linker is
      --  opencv_core.gpr Linker'Driver is not inherited by this main.
      --  Keep GNAT gcc as the Darwin link driver so the Ada runtime is
      --  linked normally. A static opencv_core archive does not encode
      --  its OpenCV/C++ runtime requirements, so apply the generated
      --  install switches to this executable as well.
      case OpenCV_Core_Install.Use_Apple_Clang is
         when "True" =>
            for Driver use "gcc";
            for Linker_Options use
              (OpenCV_Core_Install.Library_Search_Switch,
               "-lopencv_core",
               OpenCV_Core_Install.Cxx_Runtime_Switch);
         when "False" =>
            null;
      end case;
   end Linker;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Tests;
