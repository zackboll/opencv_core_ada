with "config/tests_config.gpr";
with "aunit";
with "opencv_core";

project Tests is

   --  Windows CI diagnostic experiment: statically isolate the GNAT/Ada
   --  runtime inside tests.exe while still loading libopencv_core_shim.dll.
   --  Default False keeps Linux and macOS test linking unchanged.
   type Windows_Static_Ada_Runtime_Kind is ("False", "True");
   Windows_Static_Ada_Runtime : Windows_Static_Ada_Runtime_Kind :=
     external ("TESTS_WINDOWS_STATIC_ADA_RUNTIME", "False");

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Tests_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("tests.adb");

   package Compiler is
      for Default_Switches ("Ada") use
         Tests_Config.Ada_Compiler_Switches & ("-Werror");
   end Compiler;

   package Binder is
      case Windows_Static_Ada_Runtime is
         when "True" =>
            for Switches ("Ada") use ("-Es", "-static");
         when "False" =>
            for Switches ("Ada") use ("-Es"); --  Symbolic traceback
      end case;
   end Binder;

   package Linker is
      case Windows_Static_Ada_Runtime is
         when "True" =>
            --  Communicate with C++ only through the shim DLL C ABI, so
            --  the executable can be linked with GNAT gcc. g++ injects
            --  -shared-libgcc and defeats -static-libgcc placed in
            --  Switches. Trailing_Switches come after GPRbuild's
            --  required linker switches, so -static-libgcc wins.
            for Driver use "gcc";
            for Trailing_Switches ("Ada") use ("-static-libgcc");
         when "False" =>
            null;
      end case;
   end Linker;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Tests;
