with "config/opencvcore_ada_config.gpr";
with "config/opencvcore_ada_opencv.gpr";

project Opencvcore_Ada is

   for Library_Name use "Opencvcore_Ada";
   for Library_Version use Project'Library_Name & ".so." & Opencvcore_Ada_Config.Crate_Version;

   for Languages use ("Ada", "C++");
   for Source_Dirs use ("src/", "cpp/", "config/");
   for Object_Dir use "obj/" & Opencvcore_Ada_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Library_Dir use "lib";

   type Library_Type_Type is ("relocatable", "static", "static-pic");
   Library_Type : Library_Type_Type :=
     external ("OPENCVCORE_ADA_LIBRARY_TYPE", external ("LIBRARY_TYPE", "static"));
   for Library_Kind use Library_Type;

   package Compiler is
      for Default_Switches ("Ada") use Opencvcore_Ada_Config.Ada_Compiler_Switches;
      for Default_Switches ("C++") use
        ("-std=c++17",
         "-Wall",
         "-Wextra",
         "-Wpedantic",
         Opencvcore_Ada_OpenCV.Include_Switch);
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Linker is
      for Linker_Options use
        (Opencvcore_Ada_OpenCV.Library_Search_Switch,
         "-lopencv_core",
         "-lstdc++");
   end Linker;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Opencvcore_Ada;
