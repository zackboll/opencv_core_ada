with "config/opencv_core_config.gpr";
with "config/opencv_core_install.gpr";

project OpenCV_Core is

   for Library_Name use "opencv_core_ada";
   for Library_Version use Project'Library_Name & ".so." & OpenCV_Core_Config.Crate_Version;

   for Languages use ("Ada", "C++");
   for Source_Dirs use ("src/", "src/internal/", "cpp/", "config/");
   for Object_Dir use "obj/" & OpenCV_Core_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Library_Dir use "lib";

   type Library_Type_Type is ("relocatable", "static", "static-pic");
   Library_Type : Library_Type_Type :=
     external
       ("OPENCV_CORE_LIBRARY_TYPE",
        external ("LIBRARY_TYPE", "static-pic"));
   for Library_Kind use Library_Type;

   package Compiler is
      for Default_Switches ("Ada") use
         OpenCV_Core_Config.Ada_Compiler_Switches & ("-Werror");

      for Default_Switches ("C++") use
         ("-std=c++17",
         "-Wall",
         "-Wextra",
         "-Wpedantic",
         "-Werror",
         OpenCV_Core_Install.Include_Switch);

      --  Homebrew OpenCV on macOS is built with Apple clang++ / libc++.
      --  Compile the C++ shim with that driver so Ada stays on GNAT while
      --  C++ objects match the OpenCV ABI.
      --
      --  Do not use a mixed gprconfig cgpr for this: Apple clang++ reports
      --  arm64-apple-darwin while GNAT reports aarch64-apple-darwin, and
      --  Alire's generated config cannot consume that mixed-target file.
      --  Override the C++ driver in this project instead. Configure ordinary
      --  -I include switches so GPRbuild does not fall through to the
      --  inherited GCC Include_Switches_Via_Spec mechanism that clang++
      --  rejects.
      case OpenCV_Core_Install.Use_Apple_Clang is
         when "True" =>
            for Driver ("C++") use OpenCV_Core_Install.Cxx_Driver;
            for Leading_Required_Switches ("C++") use
              ("-c",
               "-x",
               "c++",
               "-isysroot",
               OpenCV_Core_Install.MacOS_SDK_Root);
            for Include_Switches ("C++") use ("-I");
            for Dependency_Switches ("C++") use ("-MMD", "-MF", "");
         when "False" =>
            null;
      end case;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Linker is
      --  Keep GNAT gcc as the Darwin link driver so the Ada runtime is
      --  linked with GNAT's usual options. clang++ compiled the shim;
      --  Cxx_Runtime_Switch supplies -lc++ for those objects and for
      --  Homebrew OpenCV. Linux keeps the default C++ link driver and
      --  -lstdc++.
      case OpenCV_Core_Install.Use_Apple_Clang is
         when "True" =>
            for Driver use "gcc";
         when "False" =>
            null;
      end case;

      for Linker_Options use
        (OpenCV_Core_Install.Library_Search_Switch,
         "-lopencv_core",
         OpenCV_Core_Install.Cxx_Runtime_Switch);
   end Linker;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end OpenCV_Core;
