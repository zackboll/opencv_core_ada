with "config/opencv_core_config.gpr";
with "config/opencv_core_install.gpr";
with "opencv_core_shim.gpr";

project OpenCV_Core is

   for Library_Name use "opencv_core_ada";
   for Library_Version use Project'Library_Name & ".so." & OpenCV_Core_Config.Crate_Version;

   for Languages use ("Ada");
   for Source_Dirs use ("src/", "src/internal/", "config/");
   for Object_Dir use "obj/" & OpenCV_Core_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Library_Dir use "lib";

   type Library_Type_Type is ("relocatable", "static", "static-pic");
   Library_Type : Library_Type_Type :=
     external
       ("OPENCV_CORE_LIBRARY_TYPE",
        external ("LIBRARY_TYPE", "static-pic"));
   for Library_Kind use Library_Type;

   case Library_Type is
      when "relocatable" =>
         case OpenCV_Core_Install.Ada_Link is
            when "Shared_Shim_Static_GCC_Runtime" =>
               for Library_Options use
                 ("-L" & Project'Project_Dir & "lib",
                  "-lopencv_core_shim",
                  "-static-libgcc",
                  "-static-libstdc++");
            when "Default" =>
               null;
         end case;
      when "static" | "static-pic" =>
         null;
   end case;

   package Compiler is
      for Default_Switches ("Ada") use
         OpenCV_Core_Config.Ada_Compiler_Switches & ("-Werror");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Linker is
      --  Ada consumers of a shared shim may require an isolated static GCC
      --  runtime. Other consumer link strategies remain unchanged.
      case OpenCV_Core_Install.Ada_Link is
         when "Shared_Shim_Static_GCC_Runtime" =>
            for Linker_Options use
              ("-lopencv_core_shim", "-static-libgcc", "-static-libstdc++");
         when "Default" =>
            null;
      end case;
   end Linker;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end OpenCV_Core;
